generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum MerchantStatus {
  ACTIVE
  INACTIVE
  NEEDS_REVIEW
  ARCHIVED
}

enum GiftCardStatus {
  DRAFT
  ACTIVE
  HIDDEN
  EXPIRED
  ARCHIVED
}

enum VerificationStatus {
  DISCOVERED
  PENDING
  VERIFIED
  NEEDS_REVIEW
  EXPIRED
  REJECTED
}

enum GiftCardVariantType {
  DIGITAL
  PHYSICAL
  DIGITAL_AND_PHYSICAL
  CORPORATE
  EXPERIENCE
  THIRD_PARTY_PREPAID
}

enum RedemptionChannel {
  ONLINE
  PHYSICAL_STORE
  APP
  PHONE
  EMAIL
}

enum LocationCapabilityType {
  PURCHASE_IN_STORE
  REDEEM_IN_STORE
}

enum DeliveryMethod {
  EMAIL
  SMS
  VIBER
  PHYSICAL_DELIVERY
  STORE_PICKUP
  INSTANT_CODE
  PRINTABLE
}

enum SourceType {
  OFFICIAL
  AGGREGATOR
  SEARCH_ENGINE
  MARKETPLACE
  MANUAL
  OTHER
}

enum DiscoveryScanStatus {
  PENDING
  SCANNED_NO_CANDIDATE
  CANDIDATES_FOUND
  BLOCKED
  ERROR
}

enum DiscoveryStatus {
  DISCOVERED
  QUEUED
  VERIFYING
  VERIFIED
  REJECTED
  DUPLICATE
  ERROR
}

enum VerificationResult {
  PASSED
  FAILED
  CHANGED
  UNAVAILABLE
  PARTIAL
}

enum MediaUsageStatus {
  UNKNOWN
  APPROVED
  OWNED
  GENERATED
  DO_NOT_USE
}

enum VerificationMethod {
  HTTP
  PLAYWRIGHT
  LLM
  MANUAL
}

enum VerificationAttemptResult {
  PASSED
  FAILED
  AMBIGUOUS
  BLOCKED
  ERROR
}

enum VerificationPageRole {
  CANONICAL_PURCHASE
  CHECKOUT
  TERMS
  PROMOTION
  CONTENT
  GIFT_GUIDE
  GAMING_VOUCHER
  GENERIC
  UNKNOWN
}

enum ReviewFlagType {
  ROLE_CHANGED
  CANONICAL_URL_CHANGED
  FETCH_UNSTABLE
  CONTENT_CHANGED
}

enum ReviewFlagStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum RediscoveryTaskStatus {
  PENDING
  RUNNING
  RESOLVED
  MANUAL_REVIEW
  FAILED
}

enum MerchantLeadStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MerchantMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MerchantMemberRole {
  OWNER
  EDITOR
}

enum MerchantPlan {
  PARTNER
  FEATURED
  PREMIUM_BANNER
}

enum MerchantSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum MerchantMagicLinkPurpose {
  INVITE
  LOGIN
}

enum PremiumPlacementStatus {
  RESERVED
  ACTIVE
  ENDED
  CANCELED
}

/**
 * |--------------------------------------------------------------------------
 * | MERCHANT / BUSINESS
 * |--------------------------------------------------------------------------
 * |
 * | Ένα merchant = μία επιχείρηση / brand / retailer.
 * |
 * | Public
 * | Sephora
 * | AEGEAN
 * | SKY express
 * | Prénatal
 * | μικρό spa
 * | ξενοδοχείο
 * |--------------------------------------------------------------------------
 */

model Merchant {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  legalName   String?
  description String?

  websiteUrl String?
  country    String  @default("GR")

  logoUrl       String?
  logoSourceUrl String?

  status MerchantStatus @default(ACTIVE)

  featured Boolean @default(false)

  seoTitle        String?
  metaDescription String?

  giftCards GiftCard[]

  locations MerchantLocation[]

  sources     SourceRecord[]
  mediaAssets MediaAsset[]
  clicks      OutboundClick[]


  merchantLeads     MerchantLead[]         @relation("MerchantLeadMatch")
  members           MerchantMember[]       @relation("MerchantMembers")
  subscription      MerchantSubscription?  @relation("MerchantSubscription")
  premiumPlacements PremiumPlacement[]      @relation("PremiumPlacements")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@index([featured])
}

/**
 * A physical merchant point backed by an explicit source URL.
 * Location presence alone never implies gift-card purchase or redemption.
 */
model MerchantLocation {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  label              String?
  countryCode        String   @default("GR")
  administrativeArea String?
  city               String
  area               String?
  addressLine        String
  postalCode         String?
  latitude           Decimal? @db.Decimal(9, 6)
  longitude          Decimal? @db.Decimal(9, 6)

  normalizedKey String
  sourceUrl     String
  sourceExcerpt String?

  active             Boolean            @default(true)
  verificationStatus VerificationStatus @default(DISCOVERED)
  lastVerifiedAt     DateTime?
  nextReviewAt       DateTime?

  giftCardCapabilities GiftCardLocationCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, normalizedKey])
  @@index([countryCode, administrativeArea, city])
  @@index([city, area])
  @@index([verificationStatus, active])
}

/**
 * |--------------------------------------------------------------------------
 * | GIFT CARD
 * |--------------------------------------------------------------------------
 * |
 * | Canonical gift card.
 * |
 * | Π.χ.
 * | "Sephora Gift Card"
 * | "AEGEAN Gift Card"
 * |
 * | Κάτω από αυτήν μπορεί να υπάρχουν:
 * | Digital
 * | Physical
 * | Corporate
 * | κτλ.
 * |--------------------------------------------------------------------------
 */

model GiftCard {
  id         String   @id @default(cuid())
  merchantId String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  title String
  slug  String @unique

  shortDescription String?
  description      String?

  status             GiftCardStatus     @default(DRAFT)
  verificationStatus VerificationStatus @default(DISCOVERED)

  officialUrl String?

  corporateAvailable       Boolean @default(false)
  personalizationAvailable Boolean @default(false)

  validityMonths Int?
  validityText   String?

  termsUrl String?

  featured Boolean @default(false)

  lastVerifiedAt DateTime?
  nextReviewAt   DateTime?

  seoTitle        String?
  metaDescription String?

  variants    GiftCardVariant[]
  categories  GiftCardCategory[]
  occasions   GiftCardOccasion[]
  sources     SourceRecord[]
  mediaAssets MediaAsset[]
  clicks      OutboundClick[]

  verificationEvents VerificationEvent[]

  locationCapabilities GiftCardLocationCapability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewFlags ProductionReviewFlag[]

  productionVerificationSnapshots ProductionVerificationSnapshot[]

  @@index([merchantId])
  @@index([status])
  @@index([verificationStatus])
  @@index([featured])
  @@index([lastVerifiedAt])
}

/**
 * Explicit evidence for a card's in-store capability at one location.
 * No row means unknown; `available = false` is an evidenced negative claim.
 */
model GiftCardLocationCapability {
  id                 String                 @id @default(cuid())
  giftCardId         String
  giftCard           GiftCard               @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  merchantLocationId String
  merchantLocation   MerchantLocation       @relation(fields: [merchantLocationId], references: [id], onDelete: Cascade)
  capability         LocationCapabilityType
  available          Boolean                @default(true)
  verificationStatus VerificationStatus     @default(DISCOVERED)
  sourceUrl          String
  sourceExcerpt      String?
  lastVerifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([giftCardId, merchantLocationId, capability])
  @@index([merchantLocationId, capability, available])
  @@index([giftCardId, capability, available])
  @@index([verificationStatus])
}

/**
 * |--------------------------------------------------------------------------
 * | GIFT CARD VARIANTS
 * |--------------------------------------------------------------------------
 * |
 * | Το ίδιο GiftCard μπορεί να έχει:
 * |
 * | Sephora
 * | ├── Digital
 * | ├── Physical
 * | └── Corporate
 * |
 * |--------------------------------------------------------------------------
 */

model GiftCardVariant {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  name String?

  type GiftCardVariantType

  currency String @default("EUR")

  minValue Decimal? @db.Decimal(12, 2)
  maxValue Decimal? @db.Decimal(12, 2)

  customValueAllowed Boolean @default(false)

  purchaseUrl String?

  validityMonths Int?
  validityText   String?

  active Boolean @default(true)

  values      GiftCardValue[]
  redemptions GiftCardRedemption[]
  deliveries  GiftCardDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([giftCardId])
  @@index([type])
  @@index([active])
}

/**
 * |--------------------------------------------------------------------------
 * | FIXED VALUES
 * |--------------------------------------------------------------------------
 * |
 * | π.χ.
 * | €10
 * | €20
 * | €50
 * | €100
 * |--------------------------------------------------------------------------
 */

model GiftCardValue {
  id        String          @id @default(cuid())
  variantId String
  variant   GiftCardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  value Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([variantId, value])
  @@index([variantId])
}

/**
 * |--------------------------------------------------------------------------
 * | REDEMPTION CHANNELS
 * |--------------------------------------------------------------------------
 */

model GiftCardRedemption {
  id        String          @id @default(cuid())
  variantId String
  variant   GiftCardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  channel RedemptionChannel

  @@unique([variantId, channel])
  @@index([channel])
}

/**
 * |--------------------------------------------------------------------------
 * | DELIVERY METHODS
 * |--------------------------------------------------------------------------
 */

model GiftCardDelivery {
  id        String          @id @default(cuid())
  variantId String
  variant   GiftCardVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  method DeliveryMethod

  @@unique([variantId, method])
  @@index([method])
}

/**
 * |--------------------------------------------------------------------------
 * | CATEGORIES
 * |--------------------------------------------------------------------------
 */

model Category {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  icon        String?

  sortOrder Int @default(0)

  active Boolean @default(true)

  seoTitle        String?
  metaDescription String?

  giftCards GiftCardCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model GiftCardCategory {
  giftCardId String
  categoryId String

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  primary Boolean @default(false)

  @@id([giftCardId, categoryId])
  @@index([categoryId])
  @@index([primary])
}

/**
 * |--------------------------------------------------------------------------
 * | OCCASIONS
 * |--------------------------------------------------------------------------
 * |
 * | Birthday
 * | Wedding
 * | New Baby
 * | Christmas
 * | For Her
 * | κτλ.
 * |--------------------------------------------------------------------------
 */

model Occasion {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  icon        String?

  sortOrder Int @default(0)

  active Boolean @default(true)

  seoTitle        String?
  metaDescription String?

  giftCards GiftCardOccasion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([sortOrder])
}

model GiftCardOccasion {
  giftCardId String
  occasionId String

  giftCard GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  relevance Int @default(50)

  @@id([giftCardId, occasionId])
  @@index([occasionId])
  @@index([relevance])
}

/**
 * |--------------------------------------------------------------------------
 * | SOURCE RECORDS
 * |--------------------------------------------------------------------------
 * |
 * | Πολύ σημαντικό.
 * |
 * | Δεν κρατάμε απλώς "βρήκα αυτήν την gift card".
 * | Κρατάμε ΠΟΥ τη βρήκαμε.
 * |
 * | BestPrice
 * | Official Site
 * | Google
 * | Wolt
 * | Baladeur
 * | κτλ.
 * |--------------------------------------------------------------------------
 */

model SourceRecord {
  id String @id @default(cuid())

  sourceType SourceType

  sourceName String
  sourceUrl  String

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  giftCardId String?
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)

  externalId String?

  rawTitle       String?
  rawDescription String?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceType])
  @@index([sourceName])
  @@index([merchantId])
  @@index([giftCardId])
  @@index([lastSeenAt])
}

/**
 * |--------------------------------------------------------------------------
 * | DISCOVERY QUEUE
 * |--------------------------------------------------------------------------
 * |
 * | Εδώ θα μπαίνουν τα "raw" αποτελέσματα του crawler.
 * |
 * | Δεν πάνε κατευθείαν production.
 * |--------------------------------------------------------------------------
 */

model DiscoveryItem {
  id String @id @default(cuid())

  sourceType SourceType
  sourceName String

  sourceUrl String

  title        String?
  merchantName String?

  status DiscoveryStatus @default(DISCOVERED)

  possibleOfficialUrl String?

  fingerprint String? @unique

  notes String?

  verificationAttempts DiscoveryVerificationAttempt[]

  discoveredAt DateTime  @default(now())
  processedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fetchObservations VerificationFetchObservation[]

  @@index([status])
  @@index([sourceType])
  @@index([merchantName])
  @@index([discoveredAt])
}

/**
 * |--------------------------------------------------------------------------
 * | PIPELINE GOVERNANCE / OVERRIDES
 * |--------------------------------------------------------------------------
 */

model ManualCanonicalOverride {
  id String @id @default(cuid())

  merchantDomain String @unique

  forcedUrl          String
  forcedMerchantName String?

  reason String
  setBy  String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([merchantDomain])
}

model ScoringModelVersion {
  id String @id @default(cuid())

  key         String  @unique
  description String?
  config      Json

  active Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model CanonicalizationRun {
  id String @id @default(cuid())

  scoringModelKey String
  dryRun          Boolean @default(true)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  domainsProcessed Int @default(0)
  winnersSelected  Int @default(0)
  overridesApplied Int @default(0)
  errors           Int @default(0)

  notes String?

  decisions CanonicalizationDecision[]

  @@index([scoringModelKey])
  @@index([startedAt])
}

model CanonicalizationDecision {
  id String @id @default(cuid())

  runId String
  run   CanonicalizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  merchantDomain String
  candidateUrl   String
  candidateKind  String
  score          Int

  selected        Boolean @default(false)
  overrideApplied Boolean @default(false)

  reasonCodes Json
  notes       String?

  createdAt DateTime @default(now())

  @@index([runId])
  @@index([merchantDomain])
  @@index([selected])
  @@index([overrideApplied])
}

/**
 * |--------------------------------------------------------------------------
 * | DISCOVERY VERIFICATION ATTEMPTS
 * |--------------------------------------------------------------------------
 * |
 * | Immutable evidence/audit trail for HTTP -> Playwright -> LLM verification.
 * |--------------------------------------------------------------------------
 */

model DiscoveryVerificationAttempt {
  id String @id @default(cuid())

  discoveryItemId String
  discoveryItem   DiscoveryItem @relation(fields: [discoveryItemId], references: [id], onDelete: Cascade)

  method   VerificationMethod
  result   VerificationAttemptResult
  pageRole VerificationPageRole      @default(UNKNOWN)

  requestedUrl String
  finalUrl     String?

  httpStatus Int?

  confidence Float?

  modelName     String?
  promptVersion String?
  contentHash   String?

  temperature Float?

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  cacheHit Boolean @default(false)

  reasonCodes Json
  evidence    Json

  errorMessage String?

  checkedAt DateTime @default(now())

  @@index([discoveryItemId])
  @@index([method])
  @@index([result])
  @@index([pageRole])
  @@index([checkedAt])
}

/**
 * |--------------------------------------------------------------------------
 * | MANUAL VERIFICATION OVERRIDES
 * |--------------------------------------------------------------------------
 */
model ManualVerificationOverride {
  id                      String               @id @default(cuid())
  sourceUrl               String               @unique
  forcedStatus            DiscoveryStatus
  forcedPageRole          VerificationPageRole
  forcedMerchantName      String?
  reason                  String
  setBy                   String
  contentHash             String?
  lockUntilContentChanges Boolean              @default(true)
  active                  Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([active])
  @@index([forcedStatus])
}

model DomainRediscoveryTask {
  id             String                @id @default(cuid())
  merchantDomain String
  merchantName   String?
  triggerUrl     String
  triggerReason  String
  status         RediscoveryTaskStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  resolvedUrl    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([merchantDomain])
  @@index([status])
  @@index([createdAt])
}

model VerificationFetchObservation {
  id String @id @default(cuid())

  discoveryItemId String
  discoveryItem   DiscoveryItem @relation(fields: [discoveryItemId], references: [id], onDelete: Cascade)

  preflightKind String
  contentHash   String?
  httpStatus    Int?
  fetchTier     String?
  observedAt    DateTime @default(now())

  @@index([discoveryItemId, observedAt])
  @@index([preflightKind])
}

model ProductionReviewFlag {
  id String @id @default(cuid())

  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  type   ReviewFlagType
  status ReviewFlagStatus @default(OPEN)

  oldValue String?
  newValue String?
  reason   String

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([giftCardId, status])
  @@index([type, status])
}

model ProductionVerificationSnapshot {
  id String @id @default(cuid())

  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  officialUrl   String
  contentHash   String?
  pageRole      VerificationPageRole?
  httpStatus    Int?
  fetchTier     String?
  preflightKind String
  source        String
  observedAt    DateTime              @default(now())

  @@index([giftCardId, observedAt])
  @@index([officialUrl])
}

/**
 * |--------------------------------------------------------------------------
 * | VERIFICATION HISTORY
 * |--------------------------------------------------------------------------
 * |
 * | Για να έχουμε audit trail:
 * |
 * | 01/09 verified
 * | 10/12 changed
 * | 15/12 verified
 * |
 * |--------------------------------------------------------------------------
 */

model VerificationEvent {
  id String @id @default(cuid())

  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  result VerificationResult

  url String?

  notes String?

  checkedAt DateTime @default(now())

  @@index([giftCardId])
  @@index([result])
  @@index([checkedAt])
}

/**
 * |--------------------------------------------------------------------------
 * | MEDIA ASSETS
 * |--------------------------------------------------------------------------
 * |
 * | Σημαντικό για copyright / μελλοντική πώληση.
 * |
 * | Δεν θέλω να έχουμε χύμα εικόνες και μετά να μη ξέρουμε
 * | από πού προήλθαν.
 * |--------------------------------------------------------------------------
 */

model MediaAsset {
  id String @id @default(cuid())

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  giftCardId String?
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  url String

  sourceUrl String?

  altText String?

  usageStatus MediaUsageStatus @default(UNKNOWN)

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([giftCardId])
  @@index([usageStatus])
}

/**
 * |--------------------------------------------------------------------------
 * | OUTBOUND CLICK TRACKING
 * |--------------------------------------------------------------------------
 * |
 * | Από τα σημαντικότερα business metrics.
 * |--------------------------------------------------------------------------
 */

model OutboundClick {
  id String @id @default(cuid())

  merchantId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)

  giftCardId String?
  giftCard   GiftCard? @relation(fields: [giftCardId], references: [id], onDelete: SetNull)

  destinationUrl String

  sessionId String?

  referrer  String?
  userAgent String?

  source   String?
  campaign String?

  clickedAt DateTime @default(now())

  @@index([merchantId])
  @@index([giftCardId])
  @@index([clickedAt])
  @@index([source])
}

/**
 * |--------------------------------------------------------------------------
 * | IMPORT SOURCES / CRAWLER JOBS
 * |--------------------------------------------------------------------------
 */

model ImportSource {
  id String @id @default(cuid())

  name String @unique

  sourceType SourceType

  baseUrl String?

  enabled Boolean @default(true)

  totalDiscovered Int @default(0)
  totalImported   Int @default(0)
  totalRejected   Int @default(0)

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model CrawlJob {
  id String @id @default(cuid())

  sourceName String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  pagesScanned    Int @default(0)
  itemsDiscovered Int @default(0)
  itemsCreated    Int @default(0)
  errors          Int @default(0)

  successful Boolean?

  notes String?

  createdAt DateTime @default(now())

  @@index([sourceName])
  @@index([startedAt])
}

/**
 * |--------------------------------------------------------------------------
 * | SEARCH ANALYTICS
 * |--------------------------------------------------------------------------
 * |
 * | Αυτό μετά θα μας πει τι ζητά πραγματικά ο κόσμος:
 * |
 * | "δώρο για γυναίκα"
 * | "gift card 50 ευρώ"
 * | "gaming"
 * |--------------------------------------------------------------------------
 */

model SearchEvent {
  id String @id @default(cuid())

  query String

  resultsCount Int @default(0)

  sessionId String?

  clickedGiftCardId String?

  searchedAt DateTime @default(now())

  @@index([searchedAt])
  @@index([query])
}

model MerchantDiscoveryScan {
  id String @id @default(cuid())

  merchantDomain String  @unique
  merchantName   String
  websiteUrl     String
  category       String?

  status         DiscoveryScanStatus @default(PENDING)
  candidateCount Int                 @default(0)
  requestCount   Int                 @default(0)
  lastError      String?
  lastScannedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, lastScannedAt])
}


/**
 * |--------------------------------------------------------------------------
 * | MERCHANT COMMERCIAL / PORTAL
 * |--------------------------------------------------------------------------
 */

model MerchantLead {
  id String @id @default(cuid())

  businessName   String
  contactName    String
  email          String
  phone          String
  website        String?
  businessType   String
  region         String?
  category       String
  giftCardStatus String
  giftCardUrl    String?
  requestedPlan  MerchantPlan?
  message        String?

  status MerchantLeadStatus @default(SUBMITTED)

  matchedMerchantId String?
  matchedMerchant   Merchant? @relation("MerchantLeadMatch", fields: [matchedMerchantId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([matchedMerchantId])
}

model MerchantMember {
  id String @id @default(cuid())

  merchantId String
  merchant   Merchant @relation("MerchantMembers", fields: [merchantId], references: [id], onDelete: Cascade)

  email String
  name  String?

  role   MerchantMemberRole   @default(OWNER)
  status MerchantMemberStatus @default(INVITED)

  sessions   MerchantSession[]
  magicLinks MerchantMagicLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, email])
  @@index([email])
  @@index([status])
}

model MerchantSubscription {
  id String @id @default(cuid())

  merchantId String   @unique
  merchant   Merchant @relation("MerchantSubscription", fields: [merchantId], references: [id], onDelete: Cascade)

  plan   MerchantPlan
  status MerchantSubscriptionStatus @default(PENDING)

  startsAt DateTime?
  endsAt   DateTime?

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plan])
}

model MerchantMagicLink {
  id String @id @default(cuid())

  memberId String
  member   MerchantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  purpose   MerchantMagicLinkPurpose
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model MerchantSession {
  id String @id @default(cuid())

  memberId String
  member   MerchantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  expiresAt DateTime
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model PremiumPlacement {
  id String @id @default(cuid())

  merchantId String
  merchant   Merchant @relation("PremiumPlacements", fields: [merchantId], references: [id], onDelete: Cascade)

  status PremiumPlacementStatus @default(RESERVED)

  startsAt DateTime
  endsAt   DateTime

  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([status, startsAt, endsAt])
}
