/data/discovery/mass/*.backup-*
/data/discovery/mass/*resolution*.jsonl
/data/discovery/mass/*resolved*.csv
/data/discovery/mass/*master*.csv

# Local package backup
/package.pre-unified.json

# Local script backups
*.backup-before-*
