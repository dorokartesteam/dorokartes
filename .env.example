# Dorokartes.gr environment template
# Copy to .env.local for local development.
# Never commit real secret values.

# -------------------------------------------------------------------
# Core runtime
# -------------------------------------------------------------------

# PostgreSQL / Prisma connection string
DATABASE_URL=

# Canonical public application URL, e.g. https://dorokartes.gr
NEXT_PUBLIC_APP_URL=

# Admin protection used by proxy.ts
ADMIN_USER=
ADMIN_PASSWORD=

# Optional browser analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Runtime environment values are normally supplied by Node/Vercel.
# NODE_ENV=
# VERCEL_ENV=

# -------------------------------------------------------------------
# Discovery / verification pipeline
# Optional for ordinary public production runtime.
# -------------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_VERIFICATION_MODEL=

SERPER_API_KEY=

VERIFICATION_BATCH_SIZE=
VERIFICATION_USE_LLM=
VERIFICATION_USE_PLAYWRIGHT=

REDISCOVERY_BATCH_SIZE=

REVERIFY_BATCH_SIZE=
REVERIFY_DAYS=
REVERIFY_RETRY_DAYS=

# -------------------------------------------------------------------
# Verification enrichment audits
# Optional maintenance tooling.
# -------------------------------------------------------------------

VERIFICATION_V18_BATCH_SIZE=
VERIFICATION_V18_CONCURRENCY=
VERIFICATION_V18_TIMEOUT_MS=

VERIFICATION_V19_BATCH_SIZE=
VERIFICATION_V19_CONCURRENCY=
VERIFICATION_V19_TIMEOUT_MS=

CATALOG_AUDIT_STALE_DAYS=
SOURCE_BACKFILL_BATCH_SIZE=

# -------------------------------------------------------------------
# Google harvest tooling
# Optional discovery tooling.
# -------------------------------------------------------------------

GOOGLE_HARVEST_DAILY_CAP=
GOOGLE_HARVEST_DELAY_MS=
GOOGLE_HARVEST_PAGES_PER_QUERY=
GOOGLE_HARVEST_RESULTS_PER_PAGE=

# -------------------------------------------------------------------
# Universe / resolver tooling
# Optional pipeline state/configuration paths.
# -------------------------------------------------------------------

UNIVERSE_MASTER_PATH=
UNIVERSE_RESOLUTION_STATE_PATH=
UNIVERSE_RESOLVED_PATH=
UNIVERSE_RESOLVER_MODEL=
UNIVERSE_SCAN_READY_PATH=

KOUPONIA365_RESOLUTION_STATE_PATH=
KOUPONIA365_RESOLVER_MODEL=
